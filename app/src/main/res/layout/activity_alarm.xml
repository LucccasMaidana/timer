<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <!-- Icono de Alarma Pulsante -->
    <TextView
        android:id="@+id/tv_alarm_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <!-- Título Principal -->
    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_title"
        android:textColor="@color/accent_alarm"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_alarm_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <!-- Tarjeta de Ejercicio Sugerido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_card"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧘 SUGERENCIA DE MOVIMIENTO"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_exercise_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡15 Sentadillas suaves para reactivar la circulación de tus piernas!"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- Botón Principal: Detener Alarma e Iniciar Descanso -->
    <Button
        android:id="@+id/btn_alarm_start_break"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="DETENER E INICIAR DESCANSO"
        android:textColor="@color/primary_dark"
        android:backgroundTint="@color/accent_cyan"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <!-- Botón Secundario: Finalizar Día -->
    <Button
        android:id="@+id/btn_alarm_end_day"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finalizar jornada de hoy"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

</LinearLayout>
